---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'articles'>;
}

const { entry } = Astro.props;
const { title, description, category, pubDate, modDate, isFAQ, faqItems, toc } = entry.data;

const tagCls = { seo: 'tag-seo', ai: 'tag-ai', llm: 'tag-llm', business: 'tag-business' }[category] ?? 'tag-ai';
const tagLbl = { seo: 'Digital Health', ai: 'AI & LLM', llm: 'LLM', business: 'Business' }[category] ?? category;
---

<BaseLayout title={title} description={description} pubDate={pubDate} modDate={modDate} isFAQ={isFAQ} faqItems={faqItems}>
  <div class="article-body">
    <div class="article-grid">
      <div>
        <article class="article-main">
          <div class="breadcrumb mono">
            <a href="/">Home</a> /
            <a href={`/${category}`}>{tagLbl}</a>
          </div>
          <span class={`article-tag tag ${tagCls}`}>{tagLbl}</span>
          <h1 class="article-h1">{title}</h1>
          <p class="article-lead">{description}</p>
          <div class="article-dateline mono">{pubDate && pubDate.toISOString().slice(0,10)} · zeroclickjournal.com</div>
          <div class="prose"><slot /></div>
        </article>
      </div>
      <aside class="article-aside">
        {toc && toc.length > 0 && (
          <div class="aside-block">
            <p class="aside-title mono">On this page</p>
            <ul class="toc-list">
              {toc.map((item: {text:string;slug:string}) => (
                <li><a href={`#${item.slug}`}>{item.text}</a></li>
              ))}
            </ul>
          </div>
        )}
        <div class="aside-block" style="margin-top:2px">
          <p class="aside-title mono">Categories</p>
          <ul class="toc-list">
            <li><a href="/ai">AI & LLM</a></li>
            <li><a href="/seo">Digital Health</a></li>
            <li><a href="/llm">LLM Technology</a></li>
            <li><a href="/business">Business</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .tag-business { background: #b45309; color: #fff; }
</style>




















































